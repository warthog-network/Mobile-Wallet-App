# Copy to .secrets/keystore.properties (gitignored) and fill in.
# Generate: keytool -genkeypair -storetype PKCS12 -keystore .secrets/warthog-release.keystore \
#   -alias warthog -keyalg RSA -keysize 2048 -validity 10000
storeFile=warthog-release.keystore
storePassword=
keyAlias=warthog
keyPassword=
